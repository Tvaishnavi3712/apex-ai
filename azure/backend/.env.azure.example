# =============================================================================
# APEX on Azure — environment configuration
#
# Resources provisioned by infrastructure/azure/main.bicep into
# resource group `manish-dev-apex-ai-coe` (eastus).
#
# Auth is Entra ID (DefaultAzureCredential) — there are NO keys in this file.
# Locally that means your `az login` session; in Azure it's the managed identity.
#
# Usage:
#   cd backend && set -a && source .env.azure && set +a
#   uvicorn main:app --reload --port 8001
# =============================================================================

APEX_CLOUD=

# ── Subscription / RG ────────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=

# ── Cosmos DB (table store — replaces Cosmos DB) ──────────────────────────────
# NOTE: private endpoint only. Reachable from inside the VNet, or set
#       USE_LOCAL_MOCK=true for local development.
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE=
APEX_TABLE_PREFIX=

# ── Blob Storage (object store — replaces S3) ────────────────────────────────
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_BLOB_ENDPOINT=

# ── Key Vault ────────────────────────────────────────────────────────────────
AZURE_KEY_VAULT_NAME=
AZURE_KEY_VAULT_URI=

# ── Azure OpenAI / AI Foundry (model router — replaces Azure OpenAI) ──────────────
# Apex on Azure runs the latest OpenAI models.
# Point this at your Apex Foundry resource, or reuse an existing one.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_DEPLOYMENT_FAST=
# gpt-5-pro is Responses-API only (400s on chat.completions), so quality uses gpt-5.4
AZURE_OPENAI_DEPLOYMENT_QUALITY=
AZURE_OPENAI_DEPLOYMENT_EMBED=

# ── Document Intelligence (replaces Azure AI Document Intelligence) ─────────────────
AZURE_DOCINTEL_ENDPOINT=

# ── AI Search (replaces Azure OpenAI KB / OpenSearch) ─────────────────────────────
AZURE_SEARCH_ENDPOINT=

# ── Local development ────────────────────────────────────────────────────────
# Cosmos + Blob are private (ALZ policy `Deny-PublicPaaSEndpoints`), so they are
# NOT reachable from a laptop. Use the in-memory mock for local work; the
# deployed Container App inside the VNet talks to the real services.
# Cosmos + Blob are private-endpoint only -> use the persisted local mock.
USE_LOCAL_MOCK=
LOCAL_BLOB_ROOT=
APEX_MOCK_PERSIST=
APEX_MOCK_FILE=

# Azure OpenAI IS publicly reachable and RBAC is granted, so run it for REAL
# even in local development. This gives real AI over mocked private data.
AZURE_OPENAI_MOCK=

# ── API ──────────────────────────────────────────────────────────────────────
PORT=
