{
  "blueprintName": "apex-stp-incident-report-v1",
  "blueprintVersion": "1.0.0",
  "description": "Extract NRC-aligned fields from STP incident / condition reports (CR / NCR / NRR)",
  "industry": "nuclear_operations",
  "documentType": "incident_report",
  "schema": {
    "type": "object",
    "properties": {
      "report_id":     {"type": "string", "description": "CR-YYYY-NNNN, NCR-YYYY-NNNN"},
      "title":         {"type": "string"},
      "report_type":   {"type": "string", "enum": ["CR", "NCR", "NRR", "ENS"]},
      "occurred_at":   {"type": "string", "format": "date-time"},
      "discovered_at": {"type": "string", "format": "date-time"},
      "reported_by":   {"type": "string"},
      "equipment_id":  {"type": "string"},
      "system_id":     {"type": "string"},
      "unit_id":       {"type": "string"},
      "severity":      {"type": "string", "enum": ["low", "moderate", "high", "significant"]},
      "narrative":     {"type": "string"},
      "immediate_actions": {"type": "array", "items": {"type": "string"}},
      "corrective_actions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "ca_id":      {"type": "string"},
            "description": {"type": "string"},
            "due_date":   {"type": "string", "format": "date"},
            "owner":      {"type": "string"},
            "status":     {"type": "string", "enum": ["open", "closed", "overdue"]}
          }
        }
      },
      "nrc_reportable":    {"type": "boolean"},
      "ler_required":      {"type": "boolean", "description": "Licensee Event Report required?"},
      "tech_spec_entry":   {"type": "string"},
      "estimated_cost_usd": {"type": "number"}
    },
    "required": ["report_id", "title", "occurred_at", "narrative"]
  },
  "extractionRules": {
    "preserveVerbatimText": true,
    "dateFormat": "ISO8601",
    "confidenceThreshold": 0.92
  }
}
