# Apex AI Platform - Backend Environment Configuration

# Application
VERSION=
DEBUG=
ENVIRONMENT=

# AWS Configuration
AWS_REGION=
AWS_ACCOUNT_ID=
# AWS credentials should be set via AWS CLI profile or environment variables
# Do not store credentials in this file for security

# Bedrock AgentCore (optional for local dev)
AGENTCORE_GATEWAY_ID=
AGENTCORE_GATEWAY_URL=
SUPERVISOR_AGENT_ID=

# Bedrock Data Automation
BDA_PROJECT_ARN=
BDA_PROFILE_ARN=

# Bedrock Claude Model
BEDROCK_CLAUDE_MODEL_ID=

# S3 Buckets
S3_DOCUMENTS_INCOMING=apex-documents-incoming-457795063704
S3_DOCUMENTS_PROCESSED=apex-documents-processed-457795063704
S3_BLUEPRINTS=apex-blueprints-457795063704
S3_SYNTHETIC_DATA=apex-synthetic-data-457795063704

# DynamoDB Tables (matching deployed AWS tables)
DYNAMODB_PLAYBOOKS=
DYNAMODB_AGENTS=
DYNAMODB_BLUEPRINTS=
DYNAMODB_ACTIONS=
DYNAMODB_WORK_ITEMS=
DYNAMODB_SESSIONS=
DYNAMODB_AUDIT_LOGS=

# CORS
CORS_ORIGINS=

# Cognito (optional)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ──────────── Atlassian JIRA Cloud (Telecommunications cycle output) ────────────
# Generated from id.atlassian.com → Security → API tokens.
# Workspace URL must include https:// and end in .atlassian.net (no trailing slash).
# Leave any of URL / EMAIL / TOKEN blank to keep the platform in safe MOCK MODE
# — pipelines still run, tickets render with realistic mock URLs.
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT_KEY=
# Force mock mode regardless of credentials (useful for offline rehearsal).
JIRA_MOCK_MODE=
